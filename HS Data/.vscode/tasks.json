{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Watcher",
            "type": "shell",
            "command": "python",
            "args": ["scripts/watcher.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Refresh All Tables",
            "type": "shell",
            "command": "python",
            "args": ["scripts/refresh.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
